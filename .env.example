# --- project ---
PROJECT_NAME=PhishRadar - Phishing URL & Malicious Domain Threat-Intel Workbench
PROJECT_SLUG=phishradar
PROJECT_NUMBER=3

# --- server ---
HOST=127.0.0.1
PORT=8003
MAX_UPLOAD_MB=8

# --- AI (Groq only). Free key: https://console.groq.com/keys ---
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# --- demo (leave as-is for the download version) ---
DEMO_MODE=false
DEMO_TICKET_SECRET=
DEMO_DAILY_CAP=200
DEMO_MAX_UPLOAD_MB=3
TRUST_PROXY=false

# --- project settings ---
# Optional free WHOIS key. Without it, the free RDAP lookup (rdap.org) is used.
IP2WHOIS_API_KEY=your_ip2whois_key_here
# Full scans allowed per rolling hour for each visitor
DEMO_SCAN_LIMIT=15
