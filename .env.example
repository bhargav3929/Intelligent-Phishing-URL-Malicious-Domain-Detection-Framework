# Copy to .env — every key is optional. You can also paste keys in the in-app "API Keys" modal.

# Google Gemini (primary AI) — free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Groq (secondary AI fallback) — free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Optional — free RDAP lookup (rdap.org) runs automatically without this.
IP2WHOIS_API_KEY=your_ip2whois_key_here

# Model overrides (defaults shown)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# Demo rate limit (full scans per rolling hour)
# DEMO_SCAN_LIMIT=5
